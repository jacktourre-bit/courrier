# --- Feature flags (tous désactivés par défaut) ---
POSTAL_MODULE_ENABLED=false
SERVICEPOSTAL_ENABLED=false
MANUSCRY_ENABLED=false
BIRTHDAY_AUTOMATION_ENABLED=false
POSTAL_BATCH_ENABLED=false
# Données de santé / sensibles : NE PAS activer avant audit DPO + autorisation documentée (§13.2)
SENSITIVE_POSTAL_ALLOWED=false
# Connexions "production" : ignoré (forcé à false) si NODE_ENV != production
POSTAL_PRODUCTION_PROVIDERS_ALLOWED=false
NODE_ENV=development

# --- Infrastructure ---
DATABASE_URL=postgres://postal_app:CHANGE_ME@localhost:5432/app
MIGRATION_DATABASE_URL=postgres://owner:CHANGE_ME@localhost:5432/app
POSTAL_APP_ROLE=postal_app
POSTAL_BLOB_DIR=./.blobs
# 32 octets en base64 : openssl rand -base64 32
POSTAL_BLOB_KEY=
POSTAL_JWT_SECRET=
POSTAL_JWT_ISSUER=saas
PORT=8787

# --- Clés prestataires : référencées par les connexions via credentials_secret_ref = "env:NOM" ---
# SP_SANDBOX_KEY=
# MANUSCRY_KEY_SOCIETE_A=

# --- Divers ---
POSTAL_SERVICE_VAT_RATE=0.20
POSTAL_OUTBOX_MAX_ATTEMPTS=8
# Dev uniquement : accepter les pièces sans antivirus (refusé en production)
POSTAL_ALLOW_UNSCANNED_UPLOADS=false
POSTAL_ALLOW_SELF_APPROVAL_RELATIONSHIP=false
