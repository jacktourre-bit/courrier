{
  "name": "courrier-postal-module",
  "version": "0.1.0",
  "private": true,
  "description": "Module Courriers & Correspondances : Manuscry (manuscrit) + Service Postal (administratif, LR/LRAR) derrière une interface unique.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pg": "POSTAL_TEST_PG=1 vitest run tests/pg",
    "dev": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.19",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
